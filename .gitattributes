# Enforce consistent line endings so shell scripts keep working when
# checked out on Windows (CRLF breaks `exec /entrypoint.sh` in Docker).
* text=auto

# Shell scripts and bash launchers must always be LF, even on Windows.
*.sh text eol=lf
run    text eol=lf
stop   text eol=lf
seed   text eol=lf

# Windows batch/PowerShell launchers should be CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
