# Production environment variables
# Copy this to .env and fill in your values

# Django secret key (generate a secure random key)
SECRET_KEY=change-me-to-a-secure-random-key

# Your domain (Cloudflare Tunnel URL)
SITE_URL=https://hoops.bcvido.nl

# Frontend API URL (leave as http://localhost:8001 for Docker internal)
VITE_API_URL=http://localhost:8001
