# Production environment variables
# Copy this to .env and fill in your values

# Django secret key (generate a secure random key)
SECRET_KEY=change-me-to-a-secure-random-key

# Your domain (Cloudflare Tunnel URL)
SITE_URL=https://hoops.bcvido.nl

# Email Configuration (Resend SMTP)
# See: https://resend.com/docs/send-with-smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Hoops Planner <hoops-planner@yourdomain.com>
