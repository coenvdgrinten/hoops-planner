# Production environment variables
# Copy this to .env and fill in your values

# Django secret key (generate a secure random key)
SECRET_KEY=change-me-to-a-secure-random-key

# Your domain (Cloudflare Tunnel URL)
SITE_URL=https://hoops.bcvido.nl

# Frontend API URL (use http://backend:8000 for Docker internal networking)
VITE_API_URL=http://backend:8000
